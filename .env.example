# CodeBuddy/Claw 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# MiMo API 配置（必填）
MIMO_API_KEY=your_api_key_here
MIMO_API_BASE=https://api.mimo.com/v1

# 自动化任务配置
AUTOMATION_ENABLED=true

# 推送时间配置（24小时制）
ZHOUYI_PUSH_HOUR=8
ZHOUYI_PUSH_MINUTE=0
POETRY_PUSH_HOUR=9
POETRY_PUSH_MINUTE=0

# 推送方式配置
PUSH_METHOD=console  # console, email, webhook
WEBHOOK_URL=         # Webhook 地址
EMAIL_TO=            # 接收邮箱

# 数据存储目录
DATA_DIR=./data